<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent that keeps Worthwatch running in Apple's `container` tool. install-container.sh
  fills in __REPO__ and __HOME__ and copies it to ~/Library/LaunchAgents/. It starts at login
  and starts the container again if it stops. Docker doesn't need it: Docker Desktop's
  "Start when you sign in" plus the container's restart policy does the same.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.worthwatch.container</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/deploy/container/run.sh</string>
    <string>--foreground</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>WORTHWATCH_ENGINE</key>
    <string>container</string>
  </dict>
  <key>Umask</key>
  <integer>63</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/Worthwatch/container.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/Worthwatch/container.log</string>
</dict>
</plist>
