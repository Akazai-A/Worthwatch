<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for Worthwatch. install.sh fills in __HOME__ and copies this file to
  ~/Library/LaunchAgents/. It runs as you (so it can read iCloud Drive), starts at
  login, and restarts if it stops.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.worthwatch.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/worthwatch</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WORTHWATCH_DATA</key>
    <string>__HOME__/Library/Application Support/Worthwatch</string>
    <key>WORTHWATCH_BIND</key>
    <string>__BIND__</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
  <!-- 077: files it writes are readable by you only. -->
  <key>Umask</key>
  <integer>63</integer>
  <key>WorkingDirectory</key>
  <string>__HOME__/Library/Application Support/Worthwatch</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/Worthwatch/worthwatch.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/Worthwatch/worthwatch.log</string>
</dict>
</plist>
